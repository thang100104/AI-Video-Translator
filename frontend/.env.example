# Local development: empty uses Vite's /api proxy.
# Render: set the deployed backend HTTPS origin, without /api or a trailing slash.
# Example only: VITE_API_BASE=https://api.example.com
# Leave empty if backend is not deployed; production displays a configuration error.
# VITE_* values are public and embedded at build time. Never put secrets here.
VITE_API_BASE=
